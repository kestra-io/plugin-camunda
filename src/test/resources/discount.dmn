<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_discount"
             name="discount"
             namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="kestra-discount" name="Discount">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="Amount">
        <inputExpression id="inputExpression_1" typeRef="number">
          <text>amount</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Discount" name="discount" typeRef="number" />
      <rule id="rule_1">
        <inputEntry id="inputEntry_1">
          <text>&gt;= 100</text>
        </inputEntry>
        <outputEntry id="outputEntry_1">
          <text>10</text>
        </outputEntry>
      </rule>
      <rule id="rule_2">
        <inputEntry id="inputEntry_2">
          <text>&lt; 100</text>
        </inputEntry>
        <outputEntry id="outputEntry_2">
          <text>0</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
